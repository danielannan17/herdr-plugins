# Copy to the plugin config dir and fill in, or run:
#   herdr plugin action invoke configure-ai --plugin chrismalone.agent-smart-rename
#
# Location:
#   ~/.config/herdr/plugins/config/chrismalone.agent-smart-rename/provider.env
#
# The process environment overrides anything set here.

# Which backend names the agents:
#   openai  any OpenAI-compatible chat-completions endpoint (needs OPENAI_API_KEY)
#   claude  the Claude Code CLI, billed to your Claude subscription (no API key)
SMART_RENAME_PROVIDER=openai

SMART_RENAME_TIMEOUT_MS=20000

# --- openai --------------------------------------------------------------

OPENAI_API_KEY=

# Model id, passed through to the provider untouched.
SMART_RENAME_MODEL=gpt-5.6-luna

# Drop the trailing slash. Override for a non-OpenAI provider or a proxy.
SMART_RENAME_BASE_URL=https://api.openai.com/v1

# --- claude --------------------------------------------------------------

# Model alias or full name passed to `claude --model`.
# SMART_RENAME_CLAUDE_MODEL=haiku

# herdr runs plugins with a minimal PATH. Without this the plugin looks on PATH,
# then in ~/.local/bin, /opt/homebrew/bin, /usr/local/bin and ~/.claude/local.
# SMART_RENAME_CLAUDE_BIN=/Users/you/.local/bin/claude
