# Copy to the plugin config dir and fill in, or run:
#   herdr plugin action invoke configure-ai --plugin chrismalone.agent-smart-rename
#
# Location:
#   ~/.config/herdr/plugins/config/chrismalone.agent-smart-rename/provider.env
#
# Any OpenAI-compatible chat-completions endpoint works. The process
# environment overrides anything set here.

OPENAI_API_KEY=

# Model id, passed through to the provider untouched.
SMART_RENAME_MODEL=gpt-5.6-luna

# Drop the trailing slash. Override for a non-OpenAI provider or a proxy.
SMART_RENAME_BASE_URL=https://api.openai.com/v1

SMART_RENAME_TIMEOUT_MS=20000
